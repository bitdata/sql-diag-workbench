  "oraclePairs": [
    {
      "id": "space-comment",
      "expected": "same",
      "leftSql": "select a from t",
      "rightSql": "SELECT /* audited */ A FROM T"
    },
    {
      "id": "upper-quote",
      "expected": "same",
      "leftSql": "SELECT a FROM t",
      "rightSql": "SELECT \"A\" FROM \"T\""
    },
    {
      "id": "parentheses",
      "expected": "same",
      "leftSql": "SELECT a FROM t WHERE a=1",
      "rightSql": "SELECT a FROM t WHERE ((a=1))"
    },
    {
      "id": "and-order",
      "expected": "same",
      "leftSql": "SELECT a FROM t WHERE a=1 AND b=2",
      "rightSql": "SELECT a FROM t WHERE b=2 AND a=1"
    },
    {
      "id": "or-order",
      "expected": "same",
      "leftSql": "SELECT a FROM t WHERE a=1 OR b=2",
      "rightSql": "SELECT a FROM t WHERE b=2 OR a=1"
    },
    {
      "id": "number-spelling",
      "expected": "same",
      "leftSql": "SELECT CAST(1 AS NUMBER(10,2)) n FROM dual",
      "rightSql": "SELECT CAST(1 AS NUMBER(010,02)) n FROM DUAL"
    },
    {
      "id": "quote-lower",
      "expected": "different",
      "leftSql": "SELECT a FROM t",
      "rightSql": "SELECT \"a\" FROM t"
    },
    {
      "id": "quote-mixed",
      "expected": "different",
      "leftSql": "SELECT \"MiX\" FROM t",
      "rightSql": "SELECT MIX FROM t"
    },
    {
