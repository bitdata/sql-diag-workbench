{
  "name": "sql-diag-workbench",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "description": "SQL Diagnostic Workbench — Desktop application for debugging complex SQL queries",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:renderer": "vite --config vite.config.ts --mode development",
    "build": "tsc --noEmit -p tsconfig.web.json && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "preview": "electron-vite preview",
    "prepare:windows": "node scripts/prepare-windows.cjs",
    "package": "npm run prepare:windows && npm run build && electron-builder",
    "package:win:unsigned": "npm run prepare:windows && npm run build && electron-builder --win nsis --x64 --publish never --config electron-builder.unsigned.yml",
    "test": "vitest run",
    "test:electron": "vitest run --config vitest.electron.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:electron": "playwright test --config playwright.electron.config.ts",
    "e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.41.1",
    "@lezer/highlight": "^1.2.3",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@radix-ui/react-visually-hidden": "^1.2.4",
    "@tanstack/react-virtual": "^3.13.24",
    "codemirror": "^6.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql-formatter": "^15.7.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^4.1.10",
    "7zip-bin": "5.2.0",
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "pg": "^8.23.0",
    "typescript": "^5.5.3",
    "vite": "^5.4.0",
    "vitest": "^4.1.10"
  }
}
